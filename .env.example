# Configurazione MongoDB & MinIO per Atelier Liuteria Master
# Copiare in /opt/atelier-liuteria/.env (protetto dagli aggiornamenti OTA/GitHub)

MONGO_INITDB_ROOT_USERNAME=atelier
MONGO_INITDB_ROOT_PASSWORD=atelier_secret_change_me
MONGO_URI=mongodb://atelier:atelier_secret_change_me@127.0.0.1:27017/?authSource=admin
MONGO_DB=atelier_liuteria

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=atelier_minio
MINIO_SECRET_KEY=atelier_minio_secret_change_me
MINIO_BUCKET=atelier-liuteria
MINIO_SECURE=false
